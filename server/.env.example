# ============================================================
# Shoping.com Backend Environment Configuration (Render / Atlas)
# ============================================================

# Server Configuration
PORT=5000
NODE_ENV=production

# Frontend Application URL (Set this to your Vercel deployment URL)
# Example: https://shoping-app.vercel.app or http://localhost:5173 for dev
CLIENT_URL=https://your-shoping-app.vercel.app

# MongoDB Atlas Connection URI
# 1. Create a free cluster at https://www.mongodb.com/cloud/atlas
# 2. Add Network Access: 0.0.0.0/0 (allow access from anywhere for cloud deployment)
# 3. Create a Database User with readWrite permissions
# 4. Copy connection string and replace <username> and <password> below:
MONGO_URI=mongodb+srv://<username>:<password>@cluster0.abcde.mongodb.net/shoping?retryWrites=true&w=majority

# JWT Authentication
# Run `openssl rand -hex 32` or type a long random secure string
JWT_SECRET=your_super_secret_jwt_key_at_least_32_characters_long
JWT_EXPIRE=30d

# Brevo (Sendinblue) Transactional Email (Optional - for Email OTP)
# Get a free key at https://app.brevo.com
BREVO_API_KEY=xkeysib-your_brevo_api_key_here
BREVO_SENDER_EMAIL=support@shoping.com
BREVO_SENDER_NAME=Shoping.com Support

# Gmail SMTP Fallback (Optional)
GMAIL_USER=your_email@gmail.com
GMAIL_PASS=your_16_digit_google_app_password

# Google Gemini AI (Optional - for Smart Search and Recommendations)
# Get a free key at https://aistudio.google.com
GEMINI_API_KEY=your_gemini_api_key_here

# Razorpay Payment Gateway (Optional - for Checkout payments)
# Get keys at https://dashboard.razorpay.com
RAZORPAY_KEY_ID=rzp_test_your_key_id
RAZORPAY_KEY_SECRET=your_razorpay_secret_key

# Meta WhatsApp Cloud API (Optional - for Delivery WhatsApp Notifications)
WHATSAPP_ACCESS_TOKEN=your_whatsapp_access_token_here
WHATSAPP_PHONE_NUMBER_ID=your_phone_number_id_here
WHATSAPP_API_VERSION=v21.0
WHATSAPP_TEMPLATE_NAME=delivery_verification_otp
